<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Saved places, search history and downloaded maps never leave the device via backup. -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
